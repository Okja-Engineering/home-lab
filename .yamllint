# yamllint configuration, used by the yaml-lint job in
# .github/workflows/validate.yml. Errors fail the job. Warnings are reported
# and do not.
extends: default

rules:
  # The YAML in this repo does not open with "---".
  document-start: disable
  # Commit-pinned "uses:" lines and the commands quoted in comments run past
  # the default limit of 80.
  line-length:
    max: 120
    # sops writes each encrypted value of the Talos secrets bundle on one
    # line, longer than any limit. Only this rule skips the bundle. The path
    # is relative to the repository root, where the yaml-lint job runs.
    ignore: |
      platform/talos/clusters/*/secrets.sops.yaml
  # "on:" is a GitHub Actions key, not a boolean.
  truthy:
    check-keys: false
