# macOS
.DS_Store
.AppleDouble
.LSOverride

# Talos secrets and generated state
talosconfig
kubeconfig
*.talos
support-*.tar.gz

# talosctl default output names, wherever they land
# (secrets.sops.yaml, the SOPS-encrypted bundle, does not match and stays committable)
secrets.yaml
controlplane.yaml
worker.yaml
*.snapshot

# Each cluster's secrets/ and generated/ directories are ignored by
# platform/talos/.gitignore. A pattern with a slash at its start or in its
# middle is anchored to the directory of the .gitignore file that holds it, so
# a rule written here as clusters/*/... would never match
# platform/talos/clusters/...

# Environment files
.env
.env.local
.env.*.local

# Editor temp files
*~
*.swp
*.swo
*.bak
*.tmp

# IDE files
.vscode/
.idea/
*.code-workspace

# SSH keys
id_rsa
id_ed25519
*.pem
*.key

# Age encryption keys
age.key
age.txt

# Logs
*.log
logs/

# Temporary directories
tmp/
temp/
