# macOS
.DS_Store
.AppleDouble
.LSOverride

# Talos secrets and generated state
talosconfig
kubeconfig
*.talos
support-*.tar.gz

# talosctl default output names and etcd snapshots, wherever they land
# (secrets.sops.yaml, the SOPS-encrypted bundle, does not match and stays committable)
# A file with one of these three names is ignored in every directory, so a
# patch or values file needs another name, for example control-plane.yaml.
secrets.yaml
controlplane.yaml
worker.yaml
*.snapshot

# A cluster's secrets/ and generated/ directories, wherever its clusters/
# directory sits. The leading **/ is what makes these match at any depth: a
# pattern with a slash in its middle is otherwise anchored to the directory of
# the .gitignore file that holds it, so clusters/*/secrets/ written here would
# match only a clusters/ directory at the repo root, never
# platform/talos/clusters/. platform/talos/.gitignore ignores the same two
# directories for the tree that exists today.
**/clusters/*/secrets/
**/clusters/*/generated/

# Environment files
.env
.env.local
.env.*.local

# Editor temp files
*~
*.swp
*.swo
*.bak
*.tmp

# IDE files
.vscode/
.idea/
*.code-workspace

# SSH keys
id_rsa
id_ed25519
*.pem
*.key

# Age encryption keys. keys.txt is the file name sops looks for by default,
# and the name of the owner's age key file (~/.config/sops/age/keys.txt,
# outside the repo). It is ignored in every directory, so a copy that lands
# in the repo stays out of Git.
age.key
age.txt
keys.txt

# Logs
*.log
logs/

# Temporary directories
tmp/
temp/
