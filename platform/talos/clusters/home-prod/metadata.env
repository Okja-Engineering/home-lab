# Cluster metadata - non-secret values committed to Git
#
# Hardware discovery: each value marked "confirmed on cp-01 and cp-02" below was read on
# 2026-10-13 with talosctl get --insecure from two of the three machines, each running the
# stock Talos v1.13.2 image in maintenance mode, and both gave the same value. The two are
# called cp-01 and cp-02 here, in the order they were checked. cp-03 has not been checked yet.
# v1.13.2 is the version discovery was run on, not a version pin

# Cluster identity
CLUSTER_NAME="home-prod"
DOMAIN="lab.home.arpa"

# Control plane node IPs (DHCP reservations - create these before Talos installation)
CP_01_IP="10.0.0.21"
CP_02_IP="10.0.0.22"
CP_03_IP="10.0.0.23"

# Cluster endpoint (DNS A record - initially points to cp-01: 10.0.0.21)
# VIP/load balancer can be added later after control plane is healthy
CLUSTER_ENDPOINT="k8s.lab.home.arpa"

# Talos install disk (confirmed on cp-01 and cp-02, disks resource)
# Model, size and transport are recorded so that a patch can select the disk without a device path
INSTALL_DISK="/dev/nvme0n1"
INSTALL_DISK_MODEL="TWSC TSC3AN1T0-F6Q10S"
INSTALL_DISK_SIZE="1.0 TB"
INSTALL_DISK_TRANSPORT="nvme"

# Network configuration
# MAC addresses: Document locally when creating DHCP reservations, do not commit to Git
NETWORK_INTERFACE="enp3s0"  # Confirmed on cp-01 and cp-02 (links resource): the name of the one Ethernet port
NETWORK_INTERFACE_BUS_PATH="0000:03:00.0"  # Confirmed on cp-01 and cp-02 (links resource): busPath of that port
ETHERNET_PORT_COUNT="1"  # Confirmed on cp-01 and cp-02 (links resource): each has one physical Ethernet port
DNS_SERVERS="TBD"  # To be confirmed in issue 16, step 4. The gateway is not assumed to be a DNS server
NTP_SERVERS="pool.ntp.org"
DEFAULT_GATEWAY="10.0.0.1"
API_ACCESS_CIDR="10.0.0.0/24"

# Platform versions (provisional - verify compatibility before config generation)
TALOS_VERSION="v1.8.0"
KUBERNETES_VERSION="v1.31.0"

# CNI choice
CNI_PLUGIN="cilium"

# Hardware notes
CPU_VENDOR="Intel(R) Corporation"  # Confirmed on cp-01 and cp-02 (processors resource)
CPU_MODEL="12th Gen Intel(R) Core(TM) i5-12450H"  # Confirmed on cp-01 and cp-02 (processors resource)
# Also confirmed on cp-01 and cp-02: each is a GMKtec M3 with 8 cores and 12 threads, 16 GB RAM
# (2 x 8192 MiB) and a 1.0 TB NVMe disk. cp-03 is the same model by the owner's account, not yet checked
CONTROL_PLANE_NODES="3 x Intel i5 GMKtec mini PCs, 16 GB RAM each, 1 TB NVMe each"
WORKER_NODES="0 initially"
