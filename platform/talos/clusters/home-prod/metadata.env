# Cluster metadata - non-secret values committed to Git
#
# Hardware discovery: each fact below that is given with a talosctl resource was read
# from that resource on 2026-10-13, with talosctl get --insecure, on all three
# control-plane machines, each running the stock Talos v1.13.2 image in maintenance
# mode. All three gave the same value. v1.13.2 is the version discovery ran on, not a
# version pin

# Cluster identity
CLUSTER_NAME="home-prod"
DOMAIN="lab.home.arpa"

# Control plane node IPs: static addresses, set in each node's Talos machine config (ADR-007)
CP_01_IP="10.0.0.21"
CP_02_IP="10.0.0.22"
CP_03_IP="10.0.0.23"
NODE_PREFIX_LENGTH="24"  # the nodes' subnet is 10.0.0.0/24 (ADR-014)

# Cluster endpoint: the Talos shared VIP, held by one healthy control-plane node at a time
# (ADR-006). talosctl uses the node IPs, never the VIP
CLUSTER_VIP="10.0.0.20"
CLUSTER_ENDPOINT="https://10.0.0.20:6443"
API_DNS_NAME=""  # empty: the Kubernetes API has no DNS name (the name was dropped on 2026-10-13)

# Talos install disk (disks resource, all four values)
# Model, size and transport are recorded so that a patch can select the disk without a device path
INSTALL_DISK="/dev/nvme0n1"
INSTALL_DISK_MODEL="TWSC TSC3AN1T0-F6Q10S"
INSTALL_DISK_SIZE="1.0 TB"
INSTALL_DISK_TRANSPORT="nvme"

# Network configuration
# MAC addresses are not committed (ADR-007 selects ports without them). NETWORK_INTERFACE and
# NETWORK_INTERFACE_BUS_PATH identify the port
NETWORK_INTERFACE="enp3s0"  # links resource: the name of the one Ethernet port
NETWORK_INTERFACE_BUS_PATH="0000:03:00.0"  # links resource: busPath of that port
ETHERNET_PORT_COUNT="1"  # links resource: physical Ethernet ports on each machine
DNS_SERVERS="1.1.1.1 9.9.9.9"  # public resolvers, space-separated; the gateway is not one of them
# Time: authenticated with NTS (Network Time Security), decided by the owner on 2026-10-14. NTS
# needs host names, not IP addresses. To switch back, use pool.ntp.org with NTP_USE_NTS="false",
# and write useNTS: false in the patch explicitly
NTP_SERVERS="time.cloudflare.com"
NTP_USE_NTS="true"
DEFAULT_GATEWAY="10.0.0.1"

# Address ranges (ADR-014) and management sources (ADR-013). The subnet and DEFAULT_GATEWAY,
# above, are what the router check found. DHCP_POOL was set on the ISP-supplied gateway and
# read back on 2026-10-13. The node IPs, CLUSTER_VIP, WORKER_RANGE and LB_POOL are planned and
# outside DHCP_POOL; what has been checked is under "Router check" in docs/02-network-plan.md
DHCP_POOL="10.0.0.30-10.0.0.239"  # the gateway's DHCP pool
WORKER_RANGE="10.0.0.24-10.0.0.29"  # future worker nodes
LB_POOL="10.0.0.240-10.0.0.249"  # LoadBalancer addresses for applications (ADR-012)
MGMT_SOURCES="10.0.0.54/32"  # the management workstation's address (ADR-013)

# Pod and Service subnets: IPv4 only (ADR-016), and clear of the nodes' subnet 10.0.0.0/24
# (ADR-014). They are set in patches/all-nodes.yaml, not the control-plane patch, because every
# node's kubelet takes its cluster DNS address from the Service subnet. Cilium takes pod addresses
# from POD_SUBNETS
POD_SUBNETS="10.244.0.0/16"
SERVICE_SUBNETS="10.96.0.0/12"

# Platform versions and boot image (ADR-009), pinned on 2026-10-13.
# KUBERNETES_VERSION must be inside the Kubernetes range that TALOS_VERSION supports
# and the range that CILIUM_VERSION lists as tested.
# TALOS_SCHEMATIC_ID is Image Factory's ID for platform/talos/image/schematic.yaml;
# TALOS_ISO_URL and TALOS_INSTALLER_IMAGE are that schematic built for TALOS_VERSION.
# The installer image in the Talos patches must match TALOS_INSTALLER_IMAGE.
# ISO_SHA256 in step 3 of docs/runbooks/cp-01-talos-bootstrap.md is the SHA-256 of the
# image at TALOS_ISO_URL; it changes whenever TALOS_VERSION or TALOS_SCHEMATIC_ID does.
TALOS_VERSION="v1.14.2"
KUBERNETES_VERSION="1.36.5"
CILIUM_VERSION="1.20.2"
CILIUM_CHART_SHA256="b2afd87b7f75f875f92a14559f14f59b7babbb479d968e3fd625a20bf30ec20e"  # SHA-256 of cilium-<version>.tgz; helm doesn't check it; it changes with CILIUM_VERSION
TALOS_SCHEMATIC_ID="2d61dd07b20062062ea671b4d01873506103b67c0f7a4c3fb6cf4ee85585dcb8"
TALOS_ISO_URL="https://factory.talos.dev/image/2d61dd07b20062062ea671b4d01873506103b67c0f7a4c3fb6cf4ee85585dcb8/v1.14.2/metal-amd64.iso"
TALOS_INSTALLER_IMAGE="factory.talos.dev/metal-installer/2d61dd07b20062062ea671b4d01873506103b67c0f7a4c3fb6cf4ee85585dcb8:v1.14.2"

# CNI choice
CNI_PLUGIN="cilium"

# Hardware notes
CPU_VENDOR="Intel(R) Corporation"  # processors resource
CPU_MODEL="12th Gen Intel(R) Core(TM) i5-12450H"  # processors resource
# Each machine is a GMKtec M3 (systeminformation resource) with 8 cores and 12 threads (processors
# resource), 16 GB RAM (2 x 8192 MiB, ram resource) and a 1.0 TB NVMe disk (disks resource)
CONTROL_PLANE_NODES="3 x Intel i5 GMKtec mini PCs, 16 GB RAM each, 1 TB NVMe each"
WORKER_NODES="0 initially"
